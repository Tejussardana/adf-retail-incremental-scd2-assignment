{
	"name": "Credentials_Pipeline",
	"properties": {
		"activities": [
			{
				"name": "GetServerName",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kvretailkart.vault.azure.net/secrets/sql-server-name?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "set_ServerName",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "GetServerName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_serverName",
					"value": {
						"value": "@activity('GetServerName').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "GetDatabaseName",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kvretailkart.vault.azure.net/secrets/sql-database-name?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "set_DatabaseName",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "GetDatabaseName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_serverName",
					"value": {
						"value": "@activity('GetDatabaseName').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "GetUsername",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kvretailkart.vault.azure.net/secrets/sql-username?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "set_Username",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "GetUsername",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_serverName",
					"value": {
						"value": "@activity('GetUsername').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "CopyIncrementalData",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "LK_OldWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "LK_NewWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT *\nFROM @{pipeline().parameters.sourceSchemaName}.@{pipeline().parameters.sourceTableName}\nWHERE @{pipeline().parameters.watermarkColumn} > @{activity('LK_OldWatermark').output.firstRow.last_watermark_value}\n  AND @{pipeline().parameters.watermarkColumn} <= @{activity('LK_NewWatermark').output.firstRow.new_watermark_value};",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"schemaName": {
								"value": "@pipeline().parameters.sourceSchemaName",
								"type": "Expression"
							},
							"tableName": {
								"value": "@pipeline().parameters.sourceTableName",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Parquet_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"containerName": {
								"value": "@pipeline().parameters.targetContainer",
								"type": "Expression"
							},
							"folderPath": {
								"value": "@pipeline().parameters.targetFolderPath",
								"type": "Expression"
							},
							"fileName": {
								"value": "@pipeline().parameters.targetFilename",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "LK_OldWatermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "set_ServerName",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "set_DatabaseName",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "set_Username",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT last_watermark_value\nFROM dbo.pipeline_watermark\nWHERE source_table_name = @sourceTableName\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"schemaName": {
								"value": "@pipeline().parameters.sourceSchemaName",
								"type": "Expression"
							},
							"tableName": {
								"value": "@pipeline().parameters.sourceTableName",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "LK_NewWatermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "set_ServerName",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "set_DatabaseName",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "set_Username",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n'SELECT MAX(', pipeline().parameters.watermarkColumn, ') AS new_watermark_value FROM ',\npipeline().parameters.sourceSchemaName, '.', pipeline().parameters.sourceTableName\n)\n\n\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"schemaName": {
								"value": "@pipeline().parameters.sourceSchemaName",
								"type": "Expression"
							},
							"tableName": {
								"value": "@pipeline().parameters.sourceTableName",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Script1",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "CopyIncrementalData",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_SQL_RETAILKART",
					"type": "LinkedServiceReference",
					"parameters": {
						"serverSecret": "sql-server-name",
						"databaseSecret": "sql-database-name",
						"usernameSecret": "sql-username"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE dbo.pipeline_watermark\nSET last_watermark_value = activity('LK_NewWatermark').output.firstRow.value\nWHERE source_table_name = pipeline().parameters.sourceTableName",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"sourceSchemaName": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"sourceTableName": {
				"type": "string",
				"defaultValue": "retail_customers_source"
			},
			"watermarkColumn": {
				"type": "string",
				"defaultValue": "updated_at"
			},
			"targetContainer": {
				"type": "string",
				"defaultValue": "raw"
			},
			"targetFolderPath": {
				"type": "string",
				"defaultValue": "retail/customers/incremental/"
			},
			"targetFilename": {
				"type": "string",
				"defaultValue": "customers_incremental.parquet"
			}
		},
		"variables": {
			"v_serverName": {
				"type": "String"
			},
			"v_databaseName": {
				"type": "String"
			},
			"v_userName": {
				"type": "String"
			},
			"v_password": {
				"type": "String"
			}
		},
		"annotations": []
	}
}