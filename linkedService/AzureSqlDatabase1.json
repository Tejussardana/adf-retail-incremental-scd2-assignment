{
	"name": "AzureSqlDatabase1",
	"properties": {
		"parameters": {
			"ServerNameParam": {
				"type": "string",
				"defaultValue": "sql-server-name"
			},
			"DatabaseNameParam": {
				"type": "string",
				"defaultValue": "sql-database-name"
			},
			"UsernameParam": {
				"type": "string",
				"defaultValue": "sql-username"
			},
			"PasswordParam": {
				"type": "string",
				"defaultValue": "sql-password"
			}
		},
		"annotations": [],
		"type": "AzureSqlDatabase",
		"typeProperties": {
			"server": "@{linkedService().ServerNameParam}",
			"database": "@{linkedService().DatabaseNameParam}",
			"encrypt": "mandatory",
			"trustServerCertificate": false,
			"authenticationType": "SQL",
			"userName": "@{linkedService().UsernameParam}",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "KV_RETAIL_KART",
					"type": "LinkedServiceReference"
				},
				"secretName": "sql-password"
			}
		}
	}
}