{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-retail-kart"
		},
		"KV_RETAIL_KART_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kvretailkart.vault.azure.net/"
		},
		"LS_ADLSGen2_Retail_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stretailkart.dfs.core.windows.net"
		},
		"LS_SQL_RETAILKART_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "@{linkedService().serverSecret}"
		},
		"LS_SQL_RETAILKART_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().databaseSecret}"
		},
		"LS_SQL_RETAILKART_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "@{linkedService().usernameSecret}"
		},
		"LS_ADLS_RetailKart_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stretailkart.dfs.core.windows.net"
		},
		"DBS_RetailKart_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0520-142907-c922tcwy"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-retail-kart_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"KV_RETAIL_KART_properties_typeProperties_baseUrl": {
						"value": "[parameters('KV_RETAIL_KART_properties_typeProperties_baseUrl')]"
					},
					"LS_ADLSGen2_Retail_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLSGen2_Retail_properties_typeProperties_url')]"
					},
					"LS_SQL_RETAILKART_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_RETAILKART_properties_typeProperties_server')]"
					},
					"LS_SQL_RETAILKART_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_RETAILKART_properties_typeProperties_database')]"
					},
					"LS_SQL_RETAILKART_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_RETAILKART_properties_typeProperties_userName')]"
					},
					"LS_ADLS_RetailKart_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_RetailKart_properties_typeProperties_url')]"
					},
					"DBS_RetailKart_properties_typeProperties_existingClusterId": {
						"value": "[parameters('DBS_RetailKart_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}